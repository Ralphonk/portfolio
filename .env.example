# Optional: without these, the contact form creates an email draft.
# Never prefix these secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
# A sender on your verified Resend domain, e.g. Portfolio <hello@your-domain.com>
CONTACT_FROM_EMAIL=
# Exact deployed origin (or http://127.0.0.1:3016 for local direct-send testing).
CONTACT_ALLOWED_ORIGIN=
